							"fieldInstances": [
								{ "__identifier": "text", "__type": "Multilines", "__value": "Clover the Cat is an Acrobat.\nHelp Clover eat delicious ☘️ clovers ☘️ \nto feel safe and strong.\nFind the rare four-leaf 🍀 clovers 🍀 \nto grow big and long.\n\nA and D to move left and right.\nSpace to jump. (Use your left thumb)", "__tile": null, "defUid": 281, "realEditorValues": [{
									"id": "V_String",
									"params": [
										"Clover the Cat is an Acrobat.\\nHelp Clover eat delicious ☘️ clovers ☘️ \\nto feel safe and strong.\\nFind the rare four-leaf 🍀 clovers 🍀 \\nto grow big and long.\\n\\nA and D to move left and right.\\nSpace to jump. (Use your left thumb)"
									]
								}] },
